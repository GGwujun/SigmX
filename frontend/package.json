{
  "name": "sigmx-frontend",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite --mode web",
    "dev:web": "vite --mode web",
    "dev:desktop": "vite --mode desktop",
    "typecheck": "tsc -b",
    "build": "npm run typecheck && npm run build:web && npm run build:desktop",
    "build:web": "vite build --mode web",
    "build:desktop": "vite build --mode desktop",
    "preview": "vite preview --mode web",
    "preview:web": "vite preview --mode web",
    "preview:desktop": "vite preview --mode desktop",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.0",
    "clsx": "^2.1.0",
    "echarts": "^6.0.0",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.460.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.0",
    "react-router-dom": "^7.15.0",
    "rehype-highlight": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^4.1.0",
    "autoprefixer": "^10.4.0",
    "jsdom": "^27.0.1",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.4.2",
    "vitest": "^4.1.0"
  }
}
