{
  "name": "sigmx-desktop",
  "version": "0.1.7",
  "description": "SigmX desktop client — Electron shell that spawns the Python backend and serves the web UI in a native window.",
  "main": "main.js",
  "author": "SigmX",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GGwujun/SigmX.git"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "electron .",
    "dev": "cross-env SIGMX_DEV=1 electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac dmg",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "build": {
    "appId": "site.dsx-family.sigmx",
    "productName": "SigmX",
    "copyright": "Copyright © 2026 SigmX",
    "icon": "assets/icon.png",
    "files": [
      "main.js",
      "deep-link.js",
      "preload.js",
      "setup.html",
      "setup.js",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "python-dist/vibe-trading",
        "to": "python-dist/vibe-trading",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png",
      "artifactName": "SigmX-Setup-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png",
      "artifactName": "SigmX-${version}-mac-${arch}.${ext}",
      "identity": null,
      "category": "public.app-category.finance"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SigmX",
      "installerHeaderIcon": "assets/icon.png",
      "uninstallDisplayName": "SigmX ${version}"
    },
    "directories": {
      "output": "release"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
